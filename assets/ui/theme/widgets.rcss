/* アイコンを描く共通クラス(`.ic-名前`)。大きさ・位置・色は使う側のクラスが決める。
   色は`image-color`で掛ける(RmlUiには`currentcolor`が無く、文字色に追従しない)。 */
.ic-chevron-down {
    decorator: image(chevron-down none scale-none center center);
}

.ic-chevron-up {
    decorator: image(chevron-up none scale-none center center);
}

.ic-chevron-left {
    decorator: image(chevron-left none scale-none center center);
}

.ic-chevron-right {
    decorator: image(chevron-right none scale-none center center);
}

.ic-menu {
    decorator: image(menu none scale-none center center);
}

.ic-help {
    decorator: image(help none scale-none center center);
}

.ic-gear {
    decorator: image(gear none scale-none center center);
}

.ic-funnel {
    decorator: image(funnel none scale-none center center);
}

.ic-search {
    decorator: image(search none scale-none center center);
}

.ic-star {
    decorator: image(star none scale-none center center);
}

.ic-star-filled {
    decorator: image(star-filled none scale-none center center);
}

.ic-plus {
    decorator: image(plus none scale-none center center);
}

.ic-minus {
    decorator: image(minus none scale-none center center);
}

.ic-close {
    decorator: image(close none scale-none center center);
}

.ic-trash {
    decorator: image(trash none scale-none center center);
}

.ic-camera {
    decorator: image(camera none scale-none center center);
}

.ic-grip {
    decorator: image(grip none scale-none center center);
}

.ic-disable {
    decorator: image(disable none scale-none center center);
}

.ic-status-warning {
    decorator: image(status-warning none scale-none center center);
}

.ic-move-up {
    decorator: image(move-up none scale-none center center);
}

.ic-move-down {
    decorator: image(move-down none scale-none center center);
}

.ic-undo {
    decorator: image(undo none scale-none center center);
}

.ic-redo {
    decorator: image(redo none scale-none center center);
}

.ic-mode-spectate {
    decorator: image(mode-spectate none scale-none center center);
}

.ic-mode-rail {
    decorator: image(mode-rail none scale-none center center);
}

.ic-mode-train {
    decorator: image(mode-train none scale-none center center);
}

.ic-mode-signal {
